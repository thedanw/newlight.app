# Google OAuth client configuration
# Preferred: keep Google's downloaded client JSON outside the workspace and enter its full path.
GOOGLE_OAUTH_CLIENT_CONFIG_PATH=

# Alternative: copy both values from Google's installed-app OAuth client JSON.
# Never commit this file after replacing the placeholders.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URIS=http://localhost

# Optional: override the token location. By default, token.json is stored outside the
# workspace in the current user's application-data directory.
GOOGLE_OAUTH_TOKEN_PATH=
SERMON_PLANNING_DATA_DIR=
