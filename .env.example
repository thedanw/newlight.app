# ──────────────────────────────────────────────────────────────
# New Light CRM — Environment Variables
# Loaded by Vite from project root.
# ⚠️  This file is gitignored — never commit real values.
# ──────────────────────────────────────────────────────────────

# Supabase project URL (client-safe — exposed to browser)
VITE_SUPABASE_URL=

# Supabase anon/public key (client-safe — exposed to browser; used for RLS)
VITE_SUPABASE_ANON_KEY=

# Supabase service role key (SERVER-ONLY — no VITE_ prefix; never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=

# App environment for settings queries (must match across dev and prod)
# Use 'production' for deployment, 'development' for local dev testing
VITE_APP_ENV=production

# Elvanto API key — account admin → Integrations → API, or existing key in
# runsheets api.php (ELVANTO_API_KEY constant). Used by the sync worker
# and the read-only schema probe (scripts/elvanto-schema-probe.mjs).
ELVANTO_API_KEY=your_elvanto_api_key_here
# Elvanto encryption key â€” 32-byte base64-encoded string used for encrypting
# sensitive data (API keys, etc.). Must be set in production. Generate with:
# openssl rand -base64 32
VITE_ELVANTO_ENCRYPTION_KEY=your_32_byte_base64_key_here