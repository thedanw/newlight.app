# ──────────────────────────────────────────────────────────────
# New Light CRM — Environment Variables
# Loaded by Vite from project root.
# ⚠️  This file is gitignored — never commit real values.
# ──────────────────────────────────────────────────────────────

# Supabase project URL (client-safe — exposed to browser)
VITE_SUPABASE_URL=

# Supabase anon/public key (client-safe — used in browser RLS context)
VITE_SUPABASE_ANON_KEY=

# Supabase service role key (SERVER-ONLY — no VITE_ prefix; never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=
