{
  "name": "newlight-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "panda codegen && node scripts/generate-theme-colors.mjs",
    "dev": "node scripts/generate-theme-colors.mjs && node scripts/copy-plugins.mjs && node scripts/copy-theme.mjs && vite",
    "build": "node scripts/generate-theme-colors.mjs && node scripts/copy-plugins.mjs && node scripts/copy-theme.mjs && tsc -b && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "panda": "panda codegen",
    "theme:colors": "node scripts/generate-theme-colors.mjs",
    "copy-plugins": "node scripts/copy-plugins.mjs",
    "copy-theme": "node scripts/copy-theme.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.38.1",
    "@supabase/supabase-js": "^2.112.4",
    "@use-gesture/react": "^10.3.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.0",
    "@park-ui/cli": "^1.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "^8.5.26",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
