{
  "name": "newlight-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "panda codegen && node scripts/generate-theme-colors.mjs",
    "dev": "node scripts/generate-theme-colors.mjs && node scripts/copy-plugins.mjs && node scripts/copy-theme.mjs && vite",
    "build": "node scripts/generate-theme-colors.mjs && node scripts/copy-plugins.mjs && node scripts/copy-theme.mjs && node scripts/lint-pages.mjs && node scripts/lint-tokens.mjs && tsc -b && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:pages": "node scripts/lint-pages.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "panda": "panda codegen",
    "theme:colors": "node scripts/generate-theme-colors.mjs",
    "copy-plugins": "node scripts/copy-plugins.mjs",
    "copy-theme": "node scripts/copy-theme.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.38.1",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/collision": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@supabase/supabase-js": "^2.112.4",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pandacss/dev": "^1.12.0",
    "@park-ui/cli": "^1.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.0",
    "postcss": "^8.5.26",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
