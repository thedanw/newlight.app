/* --------------------------------------------------------------------------
   2. RADIUS → radii.l1 / l2 / l3
   The base semantic radii (l1 = xs, l2 = sm, l3 = md) come from panda.config.
   Each knob value shifts the whole triple up/down: l2 = knob, l1 = one step
   below, l3 = one step above.
   -------------------------------------------------------------------------- */
[data-radius='none'] {
  --radii-l1: 0;
  --radii-l2: 0;
  --radii-l3: 0;
}

[data-radius='xs'] {
  --radii-l1: var(--radii-xs);
  --radii-l2: var(--radii-sm);
  --radii-l3: var(--radii-md);
}

[data-radius='sm'] {
  --radii-l1: var(--radii-sm);
  --radii-l2: var(--radii-md);
  --radii-l3: var(--radii-lg);
}

[data-radius='md'] {
  --radii-l1: var(--radii-md);
  --radii-l2: var(--radii-lg);
  --radii-l3: var(--radii-xl);
}

[data-radius='lg'] {
  --radii-l1: var(--radii-lg);
  --radii-l2: var(--radii-xl);
  --radii-l3: var(--radii-2xl);
}

[data-radius='xl'] {
  --radii-l1: var(--radii-xl);
  --radii-l2: var(--radii-2xl);
  --radii-l3: var(--radii-3xl);
}

[data-radius='2xl'] {
  --radii-l1: var(--radii-2xl);
  --radii-l2: var(--radii-3xl);
  --radii-l3: var(--radii-4xl);
}

/* --------------------------------------------------------------------------
   3. SIDEBAR STYLE → shell vars
   Consumed by the styleguide shell (Batch 5). Default = light.
   -------------------------------------------------------------------------- */
:root {
  --sidebar-bg: var(--colors-gray-1);
  --sidebar-fg: var(--colors-gray-9);
  --sidebar-muted: var(--colors-gray-11);
  --sidebar-subtle: var(--colors-gray-10);
  --sidebar-border: var(--colors-gray-4);
  --sidebar-accent: var(--colors-color-palette-solid-bg);
  --sidebar-accent-fg: var(--colors-color-palette-solid-fg);
  --sidebar-accent-hover: var(--colors-color-palette-solid-bg-hover);
}

[data-sidebar-style='dark'] {
  --sidebar-bg: var(--colors-gray-12);
  --sidebar-fg: var(--colors-gray-1);
  --sidebar-muted: var(--colors-gray-3);
  --sidebar-subtle: var(--colors-gray-4);
  --sidebar-border: var(--colors-gray-8);
  --sidebar-accent: var(--colors-color-palette-solid-bg);
  --sidebar-accent-fg: var(--colors-color-palette-solid-fg);
}

[data-sidebar-style='brand-dark'] {
  --sidebar-bg: var(--colors-color-palette-solid-bg);
  --sidebar-fg: var(--colors-color-palette-solid-fg);
  --sidebar-muted: var(--colors-color-palette-subtle-fg);
  --sidebar-subtle: var(--colors-color-palette-2);
  --sidebar-border: var(--colors-color-palette-8);
  --sidebar-accent: var(--colors-color-palette-solid-fg);
  --sidebar-accent-fg: var(--colors-color-palette-solid-bg);
}

[data-sidebar-style='brand-light'] {
  --sidebar-bg: var(--colors-color-palette-subtle-bg);
  --sidebar-fg: var(--colors-color-palette-11);
  --sidebar-muted: var(--colors-color-palette-10);
  --sidebar-subtle: var(--colors-color-palette-9);
  --sidebar-border: var(--colors-color-palette-7);
  --sidebar-accent: var(--colors-color-palette-solid-bg);
  --sidebar-accent-fg: var(--colors-color-palette-solid-fg);
  --sidebar-accent-hover: var(--colors-color-palette-solid-bg-hover);
}

/* --------------------------------------------------------------------------
   4. HEADING STYLE → shell vars
   Space-separated checkboxes in `data-heading-style` (e.g. "bold accent").
   Consumed by the shell's Heading recipe (Batch 5).
   -------------------------------------------------------------------------- */
:root {
  --heading-font-weight: var(--font-weights-semibold);
  --heading-text-transform: none;
  --heading-letter-spacing: normal;
  --heading-color: var(--colors-fg-default);
}

[data-heading-style*='bold'] {
  --heading-font-weight: 800;
}

[data-heading-style*='uppercase'] {
  --heading-text-transform: uppercase;
  --heading-letter-spacing: 0.03em;
}

[data-heading-style*='accent'] {
  --heading-color: var(--colors-color-palette-11);
}

/* --------------------------------------------------------------------------
   5. UTILITY - utility classes (unchanged)
   -------------------------------------------------------------------------- */
/* Utility classes are defined in separate utility CSS files */