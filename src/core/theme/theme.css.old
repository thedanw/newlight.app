/* Gray theme containers - loaded dynamically based on selected gray */
/* These are loaded via JavaScript to reduce initial bundle size */

/* Neutral gray theme - loaded dynamically */
[data-gray-color='neutral'] {
  /* scale 1–12 */
  --colors-gray-1: var(--colors-neutral-1);
  --colors-gray-2: var(--colors-neutral-2);
  --colors-gray-3: var(--colors-neutral-3);
